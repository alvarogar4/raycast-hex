{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node", "react"],
    "lib": ["ES2022", "DOM", "ES2021.Intl"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "raycast-env.d.ts"]
}
